save-exact=true
engine-strict=true
fund=false
audit=false
# Dependency install scripts are not run: better-sqlite3 13 ships prebuilds (lib loads prebuilds/<platform>.node)
# but `npm ci` would otherwise try `node-gyp rebuild` because the lockfile does not record its gypfile:false.
# esbuild works without its postinstall (platform binary comes from the optional @esbuild/* package).
ignore-scripts=true
