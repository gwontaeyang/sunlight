{
  "name": "study-paper",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local single-user AI study reader for robotics papers",
  "license": "MIT",
  "engines": {
    "node": "22.23.5"
  },
  "workspaces": [
    "packages/shared",
    "apps/server",
    "apps/web"
  ],
  "scripts": {
    "doctor": "tsx scripts/doctor.ts",
    "start:user": "SP_ENV=prod tsx scripts/start-user.ts",
    "dev": "tsx scripts/check-startup-paths.ts && npm run copy:pdfjs && concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx scripts/check-startup-paths.ts && SP_ENV=dev tsx watch --clear-screen=false apps/server/src/index.ts",
    "dev:web": "tsx scripts/check-startup-paths.ts && vite --config apps/web/vite.config.ts",
    "build": "npm run copy:pdfjs && vite build --config apps/web/vite.config.ts",
    "start": "SP_ENV=prod tsx apps/server/src/index.ts",
    "typecheck": "tsc -p packages/shared && tsc -p apps/server && tsc -p apps/web && tsc -p apps/web/tsconfig.node.json && tsc -p scripts && tsc -p e2e",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "check:licenses": "tsx scripts/check-licenses.ts",
    "copy:pdfjs": "tsx scripts/copy-pdfjs-assets.ts",
    "seed:fixture": "tsx scripts/seed-fixture.ts",
    "fetch:fixtures": "tsx scripts/fetch-fixtures.ts",
    "smoke:ingest": "tsx scripts/smoke-ingest.ts",
    "test:live": "tsx scripts/smoke-live.ts",
    "eval:grounding": "tsx scripts/eval-grounding.ts",
    "live:e2e": "tsx scripts/live-e2e.ts",
    "eval:structure": "tsx scripts/eval-structure.ts",
    "data:snapshot": "exec node --import tsx scripts/data-snapshot.ts",
    "rehearsal": "tsx scripts/rehearsal.ts",
    "db:generate": "cd apps/server && drizzle-kit generate",
    "db:restore": "tsx scripts/db-restore.ts"
  },
  "overrides": {
    "katex": "0.19.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "concurrently": "10.0.7",
    "drizzle-kit": "0.31.11",
    "happy-dom": "21.0.4",
    "pdf-lib": "1.17.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
